#!/usr/bin/env bash
# Display filenames in the current directory, showing only the part after the first dash

for file in $(ls | grep -v '^\.' | grep '-')  # List files, exclude hidden files, and include only those with a dash
do
    name_after_dash=$(echo "$file" | sed 's/^[^-]*-//')  # Extract the part after the first dash
    echo "$name_after_dash"
done
