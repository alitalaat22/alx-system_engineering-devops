#!/usr/bin/env bash
# Iterate over files that are not hidden and contain a dash
for file in [0-9]*-*; do
  # Check if it's a file and not a directory
  if [ -f "$file" ]; then
    # Extract the part after the first dash
    name_after_dash="${file#*-}"
    # Print the result
    echo "$name_after_dash"
  fi
done
